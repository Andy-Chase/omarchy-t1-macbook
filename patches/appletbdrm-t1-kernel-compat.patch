+/* Bounded drain of stale T1 replies before issuing a fresh GINF request. */
+static int appletbdrm_drain_t1(struct appletbdrm_device *adev)
+{
+    struct usb_device *udev = adev_to_udev(adev);
+    u8 *buf;
+    int ret = 0, actual_size, attempt;
+    if (le16_to_cpu(udev->descriptor.idProduct) != 0x8600)
+        return 0;
+    buf = kmalloc(512, GFP_KERNEL);
+    if (!buf)
+        return -ENOMEM;
+    for (attempt = 0; attempt < 8; attempt++) {
+        ret = usb_bulk_msg(udev, usb_rcvbulkpipe(udev, adev->in_ep),
+                           buf, 512, &actual_size, 50);
+        if (ret == -ETIMEDOUT) { ret = 0; break; }
+        if (ret) break;
+        drm_info(&adev->drm, "Drained stale T1 reply: %d bytes\n", actual_size);
+    }
+    if (attempt == 8) ret = -EBUSY;
+    kfree(buf);
+    return ret;
+}
